# CryptoFolio API — variables d'environnement
# Copier ce fichier vers .env : cp .env.example .env

# Base de données (SQLite en dev local — chemin relatif à apps/api)
DATABASE_URL="file:./data/dev.db"

# Port de l'API
PORT=3001

# JWT
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m

# CORS : liste d'origines autorisées, séparées par des virgules (vide = toutes en dev)
CORS_ORIGINS=
